<div class="header-bar">
    <div class="header-title">
        <%= headerTitle %>
    </div>
    <!-- Header buttons -->
    <div class="header-buttons"></div>
    <script>
        const header_protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
        const bestellung_ws = new WebSocket(`${header_protocol}://${window.location.host}/bestellung/ws`);
        bestellung_ws.addEventListener('message', event => {
            header_state.data = JSON.parse(event.data);
            renderHeaderButtons();
        });
        const config = JSON.parse('<%- JSON.stringify(locals.config) %>');
        const headerButtons = JSON.parse('<%- JSON.stringify(headerButtons) %>');
        const header_state = {
            data: undefined,
            username: config.username,
            role: config.role,
        };
        function renderHeaderButtons() {
            const pending_orders = header_state.data.filter(item => item.status === 'IN_PROGRESS').length;
            const finished_orders = header_state.data.filter(item => item.status === 'FINISHED').length;
            const headerButtonsContainer = document.querySelector('.header-buttons');
            const cocktails_button = create_button('cocktails-button', 'Cocktails', '/');
            const ingredient_button = create_button('ingredient-button', 'Ingredients', '/ingredient');
            const cocktail_create_button = create_button('cocktail-create-button', 'Create Cocktail', '/cocktails');
            const bestellung_button_text = `
                <div>Bestellung</div>
                ${pending_orders > 0 ? `<div>Bestellt: ${pending_orders}</div>` : ''}
                ${finished_orders > 0 ? `<div>Fertig: ${finished_orders}</div>` : ''}
            `;
            const bestellung_button = create_button('bestellung-button', bestellung_button_text, '/bestellung');
            const login_button = create_button('login-button', 'Login', '/login');
            const logout_button_inner_text = `
            <div class="username-text">${config.username}</div>
            <div class="logout-text">logout</div>
        `;
            const logout_button = create_button('logout-button', logout_button_inner_text, '/logout');
            headerButtonsContainer.innerHTML = ''; // Clear existing buttons
            if (config.username) {
                if (headerButtons.includes('cocktails-button')) {
                    headerButtonsContainer.innerHTML += cocktails_button;
                }
                if (headerButtons.includes('ingredient-button') && config.role === 'ADMIN') {
                    headerButtonsContainer.innerHTML += ingredient_button;
                }
                if (headerButtons.includes('cocktail-create-button') && config.role === 'ADMIN') {
                    headerButtonsContainer.innerHTML += cocktail_create_button;
                }
                if (headerButtons.includes('bestellung-button')) {
                    headerButtonsContainer.innerHTML += bestellung_button;
                }
                headerButtonsContainer.innerHTML += logout_button;
            } else {
                headerButtonsContainer.innerHTML = `${login_button}`;
            }

            function create_button(name, text, location) {
                return `<button class="header-button ${name}" onClick="location.href='${location}'">${text}</button>`;
            }
        }
    </script>
</div>