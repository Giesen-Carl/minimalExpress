<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Fermantor - Die besten Cocktails in Düren</title>
    <link href="https://fonts.googleapis.com/css?family=Cookie" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 2rem;
            max-width: 800px;
            margin: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
        }

        th,
        td {
            padding: 0.75rem;
            border: 1px solid #ccc;
            text-align: left;
        }

        button {
            margin-right: 0.5rem;
        }

        .add-ingredient {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .add-ingredient input {
            flex: 1;
            padding: 0.5rem;
        }
    </style>
</head>

<body>
    <div class="wrapper">
        <%- include('partials/header.ejs', { headerTitle: 'Ingredient' , headerButtons: ['cocktails-button'] } ) %>
            <div>
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Available</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="ingredient-table-body">
                        <% ingredients.forEach(ingredient=> { %>
                            <tr data-name="<%= ingredient.name %>">
                                <td>
                                    <%= ingredient.name %>
                                </td>
                                <td class="availability">
                                    <%= ingredient.availability ? "✅" : "❌" %>
                                </td>
                                <td>
                                    <button onclick="toggleAvailability('<%= ingredient.name %>')">Toggle</button>
                                    <button onclick="deleteIngredient('<%= ingredient.name %>')">Delete</button>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>

                <div class="add-ingredient">
                    <input type="text" id="new-ingredient-name" placeholder="New ingredient name" />
                    <button onclick="addIngredient()">➕</button>
                </div>
            </div>
    </div> <!-- End Wrapper -->
    <script src="scripts/scripts.js"></script>
    <script>
        function toggleAvailability(name) {
            const row = document.querySelector(`tr[data-name="${name}"]`);
            const currentStatus = row.querySelector(".availability").textContent.includes("✅");
            const newAvailability = !currentStatus;
            fetch('/ingredient/availability', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ingredient_name: name, availability: newAvailability })
            })
            row.querySelector(".availability").textContent = newAvailability ? "✅" : "❌";
        }

        function deleteIngredient(name) {
            fetch('/ingredient/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ingredient_name: name })
            });
            const row = document.querySelector(`tr[data-name="${name}"]`);
            row.remove();
        }

        function addIngredient() {
            const input = document.getElementById('new-ingredient-name');
            const name = input.value.trim();
            if (!name) return;

            fetch('/ingredient/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ingredient_name: name })
            });

            const tbody = document.getElementById('ingredient-table-body');
            const newRow = document.createElement('tr');
            newRow.setAttribute('data-name', name);
            newRow.innerHTML = `
          <td>${name}</td>
          <td class="availability">✅</td>
          <td>
            <button onclick="toggleAvailability('${name}')">Toggle</button>
            <button onclick="deleteIngredient('${name}')">Delete</button>
          </td>
        `;
            tbody.appendChild(newRow);
            input.value = '';
        }
    </script>

</body>

</html>