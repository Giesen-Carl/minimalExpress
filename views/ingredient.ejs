<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Fermantor - Die besten Cocktails in Düren</title>
    <link href="https://fonts.googleapis.com/css?family=Cookie" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 2rem;
            max-width: 800px;
            margin: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
        }

        th,
        td {
            padding: 0.75rem;
            border: 1px solid #ccc;
            text-align: left;
        }

        button {
            margin-right: 0.5rem;
        }

        .add-ingredient {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .add-ingredient input {
            flex: 1;
            padding: 0.5rem;
        }
    </style>
</head>

<body>
    <div class="wrapper">
        <%- include('partials/header.ejs', { headerTitle: 'Ingredient' , headerButtons: ['cocktails-button'] } ) %>
            <table id="ingredient_table"></table>
            <div id="add_ingredient_form"></div>
    </div> <!-- End Wrapper -->
    <script>
        const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
        const ws = new WebSocket(`${protocol}://${window.location.host}/ingredient/ws`);
        console.log('TEST', ws)
        ws.addEventListener('message', event => renderData(JSON.parse(event.data)));

        function renderData(data) {
            const table = document.getElementById('ingredient_table');
            const add_ingredient_form = document.getElementById('add_ingredient_form');
            const tableHeader = `
                    <tr>
                        <th>Name</th>
                        <th>Available</th>
                        <th>Actions</th>
                    </tr>
                `;
            const tableRows = data.reduce((acc, cur) => {
                const toggleAvailability = `<button type="submit" onClick="setAvailable(${cur.id}, ${!cur.available})">Toggle</button>`;
                const deleteIngredient = `<button type="submit" onClick="deleteIngredient(${cur.id})">Delete</button>`;
                const actions = `${toggleAvailability}${deleteIngredient}`;
                return acc + `
                        <tr>
                            <td>${cur.ingredient_name}</th>
                            <td>${cur.available ? '✅' : '❌'}</th>
                            <td>${actions}</th>
                        </tr>
                    `;
            }, '')
            const addIngredient = `
                    <div class="add-ingredient">
                        <input type="text" id="new-ingredient-name" placeholder="New ingredient name" />
                        <button onclick="addIngredient()">➕</button>
                    </div>
                `;
            table.innerHTML = `${tableHeader}${tableRows}`;
            add_ingredient_form.innerHTML = `${addIngredient}`
        }

        function setAvailable(id, available) {
            fetch('/ingredient/availability', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ingredient_id: id, availability: available })
            })
        }
        function deleteIngredient(id) {
            fetch('/ingredient/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ingredient_id: id })
            });
        }
        function addIngredient() {
            const input = document.getElementById('new-ingredient-name');
            const name = input.value.trim();
            if (!name) return;

            fetch('/ingredient/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ingredient_name: name })
            });
        }
    </script>
</body>

</html>