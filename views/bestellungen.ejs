<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8">
    <title>Fermantor - Die besten Cocktails in Düren</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link href="https://fonts.googleapis.com/css?family=Cookie" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">

</head>

<body>
    <div class="wrapper">
        <%- include('partials/header.ejs', { headerTitle: 'Bestellungen' , headerButtons: ['cocktails-button'] } ) %>
            <div>
                <div class='bestellungen-container'></div>
            </div>
    </div> <!-- End Wrapper -->
    <!-- partial -->
    <script>
        const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
        const ws = new WebSocket(`${protocol}://${window.location.host}/bestellung/ws`);
        ws.addEventListener('message', event => renderData(JSON.parse(event.data)));
        function renderData(data) {
            const container = document.querySelector('.bestellungen-container');
            container.innerHTML = ''; // Clear existing content
            data.forEach(bestellung => {
                const kachel = createKachel(bestellung);
                container.innerHTML += kachel;
            });
        }
        function createKachel(bestellung) {
            console.log(bestellung)
            const timestamp = new Date(bestellung.timestamp);
            const formattedTime = timestamp.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            const status = `<div class="bestell-status ${bestellung.status === 'IN_PROGRESS' ? 'in-progress' : 'finished'}">${bestellung.status === 'IN_PROGRESS' ? 'In Arbeit' : 'Fertig'}</div>`;
            const delete_button = `<button class="bestellung-action-button delete-button" onclick="deleteBestellung(${bestellung.id})">x</button>`;
            const username = `<div class="bestellung-username">${bestellung.username}</div>`;
            const cocktail_name = bestellung.cocktail_name;
            const ingredients = bestellung.ingredients.map(ingredient => `<i>${ingredient.menge} ${ingredient.ingredient_name}</i>`).join('<br>');
            const complete_action = bestellung.status === 'IN_PROGRESS' ? `<button class="bestellung-action-button complete-button" onclick="completeBestellung(${bestellung.id})">Fertigstellen</button>` : '';

            const header_container = `<div class="header-container">${formattedTime}${status}${delete_button}</div>`;
            const subheader_container = `<div class="subheader-container">${username}</div>`;
            const cocktail_name_container = `<div class="cocktail-name-container">${cocktail_name}</div>`;
            const ingredients_container = `<div class="ingredients-container">${ingredients}</div>`;
            const complete_action_container = header_state.role === 'ADMIN' ? `<div class="complete-action-container">${complete_action}</div>` : '';
            const kachel = `
                <div class="bestellung-kachel">
                    <div>
                        ${header_container}
                        ${subheader_container}
                            <div class="cocktail-details-container">
                            ${cocktail_name_container}
                            ${ingredients_container}
                            </div>
                    </div>
                    ${complete_action_container}
                </div>
            `;
            return kachel;
        }
        async function completeBestellung(id) {
            await fetch(`/bestellung/complete/${id}`, {
                method: 'POST',
            });
        }
        async function deleteBestellung(id) {
            await fetch(`/bestellung/${id}`, {
                method: 'DELETE',
            });
        }
    </script>
</body>

</html>