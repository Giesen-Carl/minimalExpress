<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Fermantor - Die besten Cocktails in Düren</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link href="https://fonts.googleapis.com/css?family=Cookie" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 2rem;
            max-width: 800px;
            margin: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
        }

        th,
        td {
            padding: 0.75rem;
            border: 1px solid #ccc;
            text-align: left;
        }

        button {
            margin-right: 0.5rem;
        }

        .add-ingredient {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .add-ingredient input {
            flex: 1;
            padding: 0.5rem;
        }
    </style>
</head>

<body>
    <div class="wrapper">
        <%- include('partials/header.ejs', { headerTitle: 'Ingredient' , headerButtons: ['cocktails-button'] } ) %>
            <div id="root" class="root-wrapper"></div>
    </div> <!-- End Wrapper -->
    <script>
        const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
        const ws = new WebSocket(`${protocol}://${window.location.host}/ingredient/ws`);
        ws.addEventListener('message', event => {
            page_state.data = JSON.parse(event.data);
            renderData();
        });

        const page_state = {
            data: undefined,
            username: config.username,
            role: config.role,
            delete_mode: false,
        }

        function renderData() {
            const data = page_state.data;
            const root = document.getElementById('root');
            const delete_mode_button = page_state.role === 'ADMIN' ? `<button class="delete-mode-button" onClick="toggleDeleteMode()">${page_state.delete_mode ? 'delete on' : 'delete off'}</button>` : '';
            const admin_actions_container = `<div class="admin-actions-container">${delete_mode_button}</div>`;

            // ===================== INGREDIENTS ===========================

            const ingredients = data.map(item => {
                const delete_mode = page_state.delete_mode;
                const b_class_name = delete_mode ? 'delete-ingredient-button' : 'toggle-availability-button';
                const b_text = delete_mode ? 'DELETE' : 'TOGGLE';
                return `<div class="ingredient-kachel" available="${item.available}">
                        <div class="ingredient-name-container"><span>${item.ingredient_name}</span></div>
                        <button class="${b_class_name}" onClick="${delete_mode ? `deleteIngredient(${item.id})` : `setAvailable(${item.id}, ${!item.available})`}">${b_text}</button> 
                    </div>`;
            }).join('');

            // =================== INGREDIENTS ENDE ========================

            const ingredient_container = `<div id="ingredient-list">${ingredients}</div>`;
            const addIngredient = `
                    <div class="add-ingredient">
                        <input type="text" id="new-ingredient-name" placeholder="New ingredient name" />
                        <button onclick="addIngredient()">➕</button>
                    </div>
                `;
            const add_ingredients_form = `<div id="add_ingredient_form">${addIngredient}</div>`;
            root.innerHTML = `${admin_actions_container}${ingredient_container}${add_ingredients_form}`;
        }

        function setAvailable(id, available) {
            fetch('/ingredient/availability', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ingredient_id: id, availability: available })
            });
        }
        function deleteIngredient(id) {
            fetch('/ingredient/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ingredient_id: id })
            });
        }
        function addIngredient() {
            const input = document.getElementById('new-ingredient-name');
            const name = input.value.trim();
            if (!name) return;

            fetch('/ingredient/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ingredient_name: name })
            });
        }
        function toggleDeleteMode() {
            page_state.delete_mode = !page_state.delete_mode;
            renderData();
        }
    </script>
</body>

</html>